
CONFIG_TARGET_ipq807x=y
CONFIG_TARGET_ipq807x_generic=y
CONFIG_TARGET_ipq807x_generic_DEVICE_jdcloud_ax1800-pro=y

# --- 关键修改：混合 SSL ---
# 1. Wi-Fi 回退到 WolfSSL (解决 hostapd 编译失败)
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-wolfssl=y
CONFIG_PACKAGE_hostapd-common=y

# 2. Luci 界面使用默认 (通常是 WolfSSL)
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_libustream-wolfssl=y

# 3. 显式安装 OpenSSL 库 (供 Docker/Samba/Aria2 调用，但不用于 Wi-Fi)
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_openssl-util=y

# 基础系统
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# Docker 全家桶 (依赖 libopenssl，上面已选)
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y

# 存储与NAS
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y

# 下载神器
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_aria2=y

# 网络与穿透 (加回 ZeroTier)
CONFIG_PACKAGE_luci-app-zerotier=y
# 依然暂时禁用 AdGuardHome/OpenClash 以确保先编译成功
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set

# 驱动
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y

# 杂项
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ramfree=y
